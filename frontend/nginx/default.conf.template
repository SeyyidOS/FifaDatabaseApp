# Rendered at container start by the nginx image's envsubst step (only ${API_UPSTREAM} and ${EDITION} are
# substituted, see NGINX_ENVSUBST_FILTER; nginx's own $variables are left alone). The API itself checks the
# admin key.

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;
    client_max_body_size 64k;

    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    # the edition this site runs, read before the app starts (src/lib/edition.ts); EDITION in secrets.env
    location = /edition.js {
        default_type application/javascript;
        add_header Cache-Control "no-cache";
        return 200 'window.MATCHNIGHT_EDITION = "${EDITION}";\n';
    }

    location /api/ {
        proxy_pass http://${API_UPSTREAM}/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # A match photo upload (backend/photos.py) is the one large body.
    location ~ ^/api/boards/[^/]+/matches/[0-9]+/photos$ {
        client_max_body_size 12m;
        rewrite ^/api(/.*)$ $1 break;
        proxy_pass http://${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # An account's photo (backend/avatars.py): the app sends it cropped and small, the API refuses above 5 MB.
    location = /api/auth/me/photo {
        client_max_body_size 6m;
        proxy_pass http://${API_UPSTREAM}/auth/me/photo;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # Hashed build assets never change; crests rarely do.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }
    # the home-screen app's manifest (index.html links it); nginx's own types don't know the extension
    location = /manifest.webmanifest {
        default_type application/manifest+json;
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    location /crests/ {
        add_header Cache-Control "public, max-age=604800";
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
